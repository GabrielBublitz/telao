# Copie para "server/.env" e ajuste. Tudo tem um padrão razoável; comece só com o que precisar.

# ---------- Site + sinalização (WebSocket) ----------
# Porta local que o túnel/proxy HTTPS expõe. 0.0.0.0 permite testar na rede local (http://IP-LOCAL:3001).
HTTP_HOST=0.0.0.0
HTTP_PORT=3001

# Painel administrativo (sempre só em 127.0.0.1 — nunca encaminhe esta porta no roteador).
ADMIN_PORT=3002

# HTTPS público:
#   TUNNEL=cloudflared  -> Cloudflare Quick Tunnel gratuito, sem conta (URL *.trycloudflare.com muda a cada reinício)
#   TUNNEL=none + PUBLIC_URL -> você já tem um HTTPS apontando para HTTP_PORT (Caddy+DuckDNS, Tailscale Funnel...)
TUNNEL=cloudflared
# CLOUDFLARED_PATH=C:\Program Files (x86)\cloudflared\cloudflared.exe
# PUBLIC_URL=https://meutelao.duckdns.org

# Frontend hospedado na Vercel (opcional). Os links passam a apontar para a Vercel e carregam o endereço do servidor.
# WEB_URL=https://telao-seunome.vercel.app
# Origens extras autorizadas a abrir o WebSocket (separadas por vírgula).
# ALLOWED_ORIGINS=

# ---------- Mídia (WebRTC / mediasoup) ----------
# Porta(s) que precisam ser encaminhadas no roteador para o IP local deste PC.
MEDIA_UDP_PORT=40000
MEDIA_TCP_PORT=40000
# IP local onde o mediasoup escuta. "auto" = interface com rota para a internet.
MEDIA_LISTEN_IP=auto
# Endereço anunciado aos navegadores: auto (IP público via STUN) | none (só rede local) | IP | hostname
# Ex. com playit.gg (CGNAT): MEDIA_ANNOUNCED_ADDRESS=abc-def.gl.at.ply.gg  e  MEDIA_UDP_PORT=<porta pública do túnel>
MEDIA_ANNOUNCED_ADDRESS=auto
# auto = também anuncia o IPv6 global do PC (alternativa sob CGNAT). off = desliga.
MEDIA_IPV6=auto

# ---------- ICE ----------
# STUN público gratuito (opcional neste desenho; o servidor já tem endereço público).
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
# TURN próprio (opcional, avançado — veja o README). Credenciais temporárias são geradas automaticamente.
# TURN_URLS=turns:turn.seudominio.com:443?transport=tcp
# TURN_SECRET=um-segredo-longo-e-aleatorio

# ---------- Limites ----------
MAX_ROOMS=5
# Espectadores por sala. Upload necessário ≈ espectadores × bitrate (8 × 5 Mbps = 40 Mbps).
MAX_VIEWERS=8
ROOM_TTL_HOURS=12
DEFAULT_BITRATE_KBPS=5000
MAX_BITRATE_KBPS=8000

LOG_LEVEL=info
